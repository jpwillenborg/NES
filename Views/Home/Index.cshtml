@model IEnumerable<NES_Box_Art.Models.TimelineGameViewModel>
@using IGDB

@{
    ViewData["Title"] = "Memory Allocation Matrix";
}

<style>
    #nes-matrix-wrapper .portfolio-tag-line {
        font-family: 'Geist Mono', SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
        font-size: 1.1rem !important;
        color: #00e5ff !important;
        letter-spacing: 0.05em !important;
        font-weight: 400 !important;
    }
    #nes-matrix-wrapper .portfolio-main-title {
        font-family: 'Geist', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
        font-size: 2.1rem !important;
        font-weight: 600 !important;
        letter-spacing: -0.01em !important;
        color: #ffffff !important;
        line-height: 1.2 !important;
    }
    #nes-matrix-wrapper p,
    #nes-matrix-wrapper h3, 
    #nes-matrix-wrapper h4, 
    #nes-matrix-wrapper strong {
        font-family: 'Geist', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    }
    #nes-matrix-wrapper .select-engine-container {
        position: relative !important;
        display: block !important;
        width: 100% !important;
    }
    #nes-matrix-wrapper .select-engine-container::after {
        content: "\25BC" !important;
        font-size: 0.7rem !important;
        color: #a0aec0 !important;
        position: absolute !important;
        right: 0.95rem !important;
        top: 50% !important;
        transform: translateY(-50%) !important;
        pointer-events: none !important;
    }
    #matrix-sort-dropdown {
        -webkit-appearance: none !important;
        -moz-appearance: none !important;
        appearance: none !important;
        padding-right: 3rem !important;
    }
</style>

<div id="nes-matrix-wrapper" class="w-full relative pb-12">
    <div class="mb-10 text-left flex flex-col gap-0 w-full pt-4">
        <span class="portfolio-tag-line block mb-0">02 / Systems Insight</span>
        <h1 class="portfolio-main-title m-0 pt-1">
            NES System Bus &amp; Memory Allocation Matrix
        </h1>
        <p class="m-0 text-[#a0aec0] text-[1.05rem] leading-[1.65] tracking-normal opacity-85 pt-4">
            Standard NES hardware was originally restricted to a small 64KB address space boundary - until custom Memory Management Controllers (MMCs) or Mappers were introduced. This tool helps visualize how mappers expanded the boundaries to house larger game maps and complex audio.
        </p>
        <p class="m-0 text-[#a0aec0] text-[1.05rem] leading-[1.65] tracking-normal opacity-85" style="margin-top: 1.5rem !important;">
            Select two games from the list to see how <span class="text-[#ce0e00] font-semibold">CARTRIDGE A</span> and <span class="text-[#8c9b96] font-semibold">CARTRIDGE B</span> compare in terms of memory footprint.
        </p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="bg-red-900/20 border border-red-500/40 p-4 rounded-[8px] text-red-400 mb-6 font-mono text-sm" role="alert">
            @ViewBag.Error
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch mt-12">
        <div class="col-span-1 flex flex-col h-full">
            <div class="bg-[#111823] p-4 rounded-[12px] shadow-[0_4px_20px_rgba(0,0,0,0.25)] flex items-center justify-between gap-4 mb-4 flex-shrink-0">
                <div class="flex-grow text-left">
                    <span class="text-[0.8rem] font-bold text-[#a0aec0] uppercase tracking-wider block mb-1">Bus Matrix Sorting Engine</span>
                    <div class="select-engine-container">
                        <select id="matrix-sort-dropdown" class="bg-[#090d16] text-white text-[0.95rem] rounded-[6px] p-2 w-full outline-none focus:border-[#00e5ff] cursor-pointer" style="border: none !important;">
                            <option value="date-oldest">Release Date (Oldest)</option>
                            <option value="date-newest">Release Date (Newest)</option>
                            <option value="alpha-asc">Alphabetical (A-Z)</option>
                            <option value="size-desc">Size (Largest First)</option>
                        </select>
                    </div>
                </div>
                <button type="button" id="reset-sorting" class="bg-transparent text-[#a0aec0] font-medium text-[0.85rem] rounded-[6px] px-3 py-2 mt-5 hover:bg-[#161f2d] hover:text-white transition-all duration-200" style="border: none !important;">Reset</button>
            </div>
            <div class="flex-grow h-0 min-h-[300px] flex flex-col gap-3 overflow-y-auto pr-1 portfolio-scrollbar" id="game-selection-list">
                @foreach (var item in Model)
                {
                    var imageId = item.IgdbData.Cover?.Value?.ImageId;
                    var imageUrl = !string.IsNullOrEmpty(imageId) 
                        ? IGDB.ImageHelper.GetImageUrl(imageId, ImageSize.CoverBig, false).Replace("//", "https://") 
                        : "";
                    
                    var splitParts = item.ReleaseYear.Split('|');
                    string displayDate = item.ReleaseYear;
                    string rawDateKey = "";

                    if (splitParts.Length > 1)
                    {
                        displayDate = splitParts[1];
                    }
                    if (splitParts.Length > 0)
                    {
                        rawDateKey = splitParts[0];
                    }

                    <div class="bg-[#111823] rounded-[10px] p-4 flex items-center gap-4 transition-colors duration-250 ease-out hover:bg-[#161f2d] cursor-pointer shadow-md group game-comparison-card flex-shrink-0" style="border: none !important;" data-size="@item.SizeInKb" data-name="@item.IgdbData.Name" data-chip="@item.MapperChip" data-date="@displayDate" data-datekey="@rawDateKey">
                        <div class="flex-shrink-0 w-14 h-auto min-h-[4rem] bg-black/20 rounded-[4px] p-0.5 flex items-center justify-center overflow-hidden" style="border: none !important;">
                            @if (!string.IsNullOrEmpty(imageUrl))
                            {
                                <img src="@imageUrl" alt="" class="w-full h-auto max-h-16 object-contain opacity-80 group-hover:opacity-100 transition-opacity" />
                            }
                        </div>
                        <div class="flex-grow text-left min-w-0 w-full overflow-hidden">
                            <h4 class="text-white font-bold text-[1.05rem] m-0 tracking-tight leading-tight group-hover:text-[#8c9b96] transition-colors truncate block">@item.IgdbData.Name</h4>
                            <span class="text-[#a0aec0] text-[0.85rem] font-mono block pt-1 truncate">@item.MapperChip | @displayDate</span>
                        </div>
                        <div class="flex-shrink-0 text-right flex flex-col gap-1 items-end">
                            <span class="bg-black/40 px-2 py-0.5 rounded-[4px] font-mono text-[0.85rem] font-bold text-white" style="border: none !important;">@item.SizeInKb K</span>
                            <span class="text-[0.75rem] font-mono font-bold text-[#475569] tracking-wider uppercase slot-status-badge">Idle</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-span-1 md:col-span-2 flex flex-col gap-6 h-full justify-between">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 flex-shrink-0">
                <div class="bg-[#111823] p-4 rounded-[16px] border-l-[4px] border-l-[#ce0e00] flex gap-4 shadow-[0_4px_20px_rgba(0,0,0,0.25)] items-center min-w-0 overflow-hidden" style="border-top: none !important; border-right: none !important; border-bottom: none !important; height: 120px !important;">
                    <div class="w-16 h-24 bg-black/20 rounded-[6px] p-0.5 flex-shrink-0 flex items-center justify-center overflow-hidden" style="border: none !important;">
                        <div id="slot-a-fallback" class="w-full h-full flex items-center justify-center text-[#475569] text-xs font-mono">[ A ]</div>
                        <img id="slot-a-img" src="" alt="" class="max-w-full max-h-full object-contain hidden" />
                    </div>
                    <div class="flex flex-col justify-center flex-grow min-w-0 w-full overflow-hidden">
                        <span class="text-[0.8rem] font-bold text-[#ce0e00] uppercase tracking-wider block leading-none">Cart A Active</span>
                        <strong id="slot-a-name" class="text-white text-[1.25rem] tracking-tight font-extrabold leading-tight truncate block pt-1">Select Component...</strong>
                        <span id="slot-a-meta" class="text-[#a0aec0] font-mono text-[0.9rem] block truncate leading-none pt-1">00 KB | NROM | NONE</span>
                    </div>
                </div>

                <div class="bg-[#111823] p-4 rounded-[16px] border-l-[4px] border-l-[#8c9b96] flex gap-4 shadow-[0_4px_20px_rgba(0,0,0,0.25)] items-center min-w-0 overflow-hidden" style="border-top: none !important; border-right: none !important; border-bottom: none !important; height: 120px !important;">
                    <div class="w-16 h-24 bg-black/20 rounded-[6px] p-0.5 flex-shrink-0 flex items-center justify-center overflow-hidden" style="border: none !important;">
                        <div id="slot-b-fallback" class="w-full h-full flex items-center justify-center text-[#475569] text-xs font-mono">[ B ]</div>
                        <img id="slot-b-img" src="" alt="" class="max-w-full max-h-full object-contain hidden" />
                    </div>
                    <div class="flex flex-col justify-center flex-grow min-w-0 w-full overflow-hidden">
                        <span class="text-[0.8rem] font-bold text-[#8c9b96] uppercase tracking-wider block leading-none">Cart B Active</span>
                        <strong id="slot-b-name" class="text-white text-[1.25rem] tracking-tight font-extrabold leading-tight truncate block pt-1">Select Component...</strong>
                        <span id="slot-b-meta" class="text-[#a0aec0] font-mono text-[0.9rem] block truncate leading-none pt-1">00 KB | NROM | NONE</span>
                    </div>
                </div>
            </div>

            <div id="grid-parent-card" class="bg-[#111823] p-6 rounded-[16px] shadow-[0_4px_20px_rgba(0,0,0,0.25)] flex flex-col gap-4 flex-grow justify-between" style="border: none !important;">
                <div class="flex justify-between items-center border-b border-[#1a2333] pb-4 flex-shrink-0">
                    <h3 class="m-0 text-[1.25rem] font-bold text-white tracking-tight">Visual Size Comparison (In KB)</h3>
                    <div id="comparison-delta-panel" class="text-right font-mono font-bold text-[#a0aec0] text-[0.95rem]">
                        Delta Resolution Gap: <span class="text-white font-extrabold" id="delta-span">0 KB</span>
                    </div>
                </div>
                
                <div class="bg-[#090d16] rounded-[12px] p-6 flex flex-col gap-4 box-border flex-grow justify-between" style="border: none !important;">
                    <div id="allocation-matrix-grid" class="grid grid-cols-16 sm:grid-cols-32 gap-1.5 w-full justify-center p-1">
                        @for (int i = 0; i < 768; i++)
                        {
                            <div class="aspect-square bg-[#111823] rounded-[2px] transition-all duration-150 memory-block-node" data-index="@i" title="Memory Block @(i + 1) (1 KB)" style="border: none !important;"></div>
                        }
                    </div>
                    
                    <div class="flex items-center justify-start gap-6 border-t border-[#1a2333] pt-4 font-mono text-sm text-[#a0aec0] flex-wrap flex-shrink-0">
                        <div class="flex items-center gap-2">
                            <div class="w-3 h-3 bg-[#111823] rounded-[2px]"></div>
                            <span>Empty Bank</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="w-3 h-3 bg-[#ce0e00] rounded-[2px]"></div>
                            <span>Cart A Only</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="w-3 h-3 bg-[#8c9b96] rounded-[2px]"></div>
                            <span>Cart B Only</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="w-3 h-3 bg-[#ef4444] rounded-[2px]"></div>
                            <span>Overlapping Banks</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
document.addEventListener("DOMContentLoaded", () => {
    let sizeA = 0;
    let sizeB = 0;
    let clickCounter = 0;

    const gameListContainer = document.getElementById("game-selection-list");
    const deltaSpan = document.getElementById("delta-span");
    const gridNodes = document.querySelectorAll(".memory-block-node");
    const sortDropdown = document.getElementById("matrix-sort-dropdown");

    const slotA = {
        name: document.getElementById("slot-a-name"),
        meta: document.getElementById("slot-a-meta"),
        img: document.getElementById("slot-a-img"),
        fallback: document.getElementById("slot-a-fallback")
    };

    const slotB = {
        name: document.getElementById("slot-b-name"),
        meta: document.getElementById("slot-b-meta"),
        img: document.getElementById("slot-b-img"),
        fallback: document.getElementById("slot-b-fallback")
    };

    if (gameListContainer) {
        gameListContainer.addEventListener("click", (e) => {
            const card = e.target.closest(".game-comparison-card");
            if (!card) return;

            const size = parseInt(card.getAttribute("data-size")) || 0;
            const name = card.getAttribute("data-name") || "";
            const chip = card.getAttribute("data-chip") || "";
            const date = card.getAttribute("data-date") || "";
            const imgSrc = card.querySelector("img") ? card.querySelector("img").getAttribute("src") : "";
            const statusBadge = card.querySelector(".slot-status-badge");

            clickCounter++;

            if (clickCounter % 2 !== 0) {
                sizeA = size;
                updateSlot(slotA, name, size, chip, date, imgSrc);
                clearBadgeText("Cart A");
                if (statusBadge) {
                    statusBadge.textContent = "Cart A";
                    statusBadge.className = "text-[0.75rem] font-mono font-bold text-[#ce0e00] tracking-wider uppercase slot-status-badge";
                }
            } else {
                sizeB = size;
                updateSlot(slotB, name, size, chip, date, imgSrc);
                clearBadgeText("Cart B");
                if (statusBadge) {
                    statusBadge.textContent = "Cart B";
                    statusBadge.className = "text-[0.75rem] font-mono font-bold text-[#8c9b96] tracking-wider uppercase slot-status-badge";
                }
            }

            updateMemoryAllocationMatrix();
        });
    }

    if (sortDropdown) {
        sortDropdown.addEventListener("change", () => {
            const cards = Array.from(document.querySelectorAll(".game-comparison-card"));
            const criteria = sortDropdown.value;

            cards.sort((a, b) => {
                if (criteria === "alpha-asc") {
                    return a.getAttribute("data-name").localeCompare(b.getAttribute("data-name"));
                } else if (criteria === "size-desc") {
                    return parseInt(b.getAttribute("data-size")) - parseInt(a.getAttribute("data-size"));
                } else if (criteria === "date-newest") {
                    return b.getAttribute("data-datekey").localeCompare(a.getAttribute("data-datekey"));
                } else {
                    return a.getAttribute("data-datekey").localeCompare(b.getAttribute("data-datekey"));
                }
            });

            cards.forEach(card => gameListContainer.appendChild(card));
        });
    }

    function updateSlot(slot, name, size, chip, date, imgSrc) {
        if (!slot.name || !slot.meta) return;
        slot.name.textContent = name;
        slot.meta.textContent = `${size} KB | ${chip} | ${date}`;
        if (imgSrc && slot.img && slot.fallback) {
            slot.img.setAttribute("src", imgSrc);
            slot.img.classList.remove("hidden");
            slot.fallback.classList.add("hidden");
        } else if (slot.img && slot.fallback) {
            slot.img.classList.add("hidden");
            slot.fallback.classList.remove("hidden");
        }
    }

    function clearBadgeText(keepBadge) {
        document.querySelectorAll(".game-comparison-card").forEach(card => {
            const badge = card.querySelector(".slot-status-badge");
            if (badge && badge.textContent === keepBadge) {
                badge.textContent = "Idle";
                badge.className = "text-[0.75rem] font-mono font-bold text-[#475569] tracking-wider uppercase slot-status-badge";
            }
        });
    }

    const resetBtn = document.getElementById("reset-sorting");
    if (resetBtn) {
        resetBtn.addEventListener("click", () => {
            sizeA = 0;
            sizeB = 0;
            clickCounter = 0;
            
            if (slotA.name) slotA.name.textContent = "Select Component...";
            if (slotA.meta) slotA.meta.textContent = "00 KB | NROM | NONE";
            if (slotA.img) slotA.img.classList.add("hidden");
            if (slotA.fallback) slotA.fallback.classList.remove("hidden");
            
            if (slotB.name) slotB.name.textContent = "Select Component...";
            if (slotB.meta) slotB.meta.textContent = "00 KB | NROM | NONE";
            if (slotB.img) slotB.img.classList.add("hidden");
            if (slotB.fallback) slotB.fallback.classList.remove("hidden");

            document.querySelectorAll(".slot-status-badge").forEach(badge => {
                badge.textContent = "Idle";
                badge.className = "text-[0.75rem] font-mono font-bold text-[#475569] tracking-wider uppercase slot-status-badge";
            });
            
            updateMemoryAllocationMatrix();
        });
    }

    function updateMemoryAllocationMatrix() {
        const delta = Math.abs(sizeA - sizeB);
        if (deltaSpan) {
            deltaSpan.textContent = `${delta} KB`;
        }

        gridNodes.forEach((node) => {
            const currentKb = parseInt(node.getAttribute("data-index")) + 1;
            node.className = "aspect-square rounded-[2px] transition-all duration-150 memory-block-node";

            if (currentKb <= sizeA && currentKb <= sizeB) {
                node.style.backgroundColor = "#ef4444";
            } else if (currentKb <= sizeA) {
                node.style.backgroundColor = "#ce0e00";
            } else if (currentKb <= sizeB) {
                node.style.backgroundColor = "#8c9b96";
            } else {
                node.style.backgroundColor = "#111823";
            }
        });
    }
});
</script>
